#pragma once

// Copy to secrets.h (gitignored) and set your local connection details.

#define TTC_WIFI_SSID "YOUR_WIFI_NAME"
#define TTC_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Optional fallback Wi-Fi; define both values together.
// #define TTC_WIFI_FALLBACK_SSID "SECOND_WIFI_NAME"
// #define TTC_WIFI_FALLBACK_PASSWORD "SECOND_WIFI_PASSWORD"

// Use the server's LAN address; localhost points to the ESP32.
#define TTC_FRAME_URL \
    "http://192.168.1.100:8000/api/v1/led-state.bin?map=rev-a"

// Polling interval in milliseconds.
#define TTC_POLL_INTERVAL_MS 3000

// Blank outputs after this long without a valid response (milliseconds).
#define TTC_STALE_AFTER_MS 180000
#define TTC_HTTP_TIMEOUT_MS 8000

// Set to 1 while validating the wiring through the serial monitor.
#define TTC_VERBOSE_LED_LOG 1

// Set to 0 to validate only the HTTP/serial pipeline without driving GPIO pins.
#define TTC_ENABLE_SHIFT_OUTPUT 1
