#pragma once

// Copy this file to secrets.h, then edit the local values below.
// secrets.h is ignored by Git so Wi-Fi credentials and the LAN URL are never
// committed. The firmware never prints either password or the configured URL.

#define TTC_WIFI_SSID "YOUR_WIFI_NAME"
#define TTC_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Optional second profile. The firmware tries each profile when connecting and
// fails over to the next one after a connection timeout. Keep both definitions
// together or leave both commented out.
// #define TTC_WIFI_FALLBACK_SSID "SECOND_WIFI_NAME"
// #define TTC_WIFI_FALLBACK_PASSWORD "SECOND_WIFI_PASSWORD"

// Use the laptop's LAN IP and ttcmap server port. Do not use localhost or
// 127.0.0.1: those point back to the ESP32 itself. The server defaults to 8000.
// map= must name a file in hardware/led-maps/. rev-a was removed with the 74HC595
// board, so add a 24-channel map for the TLC5947 test PCB and name it here.
#define TTC_FRAME_URL \
    "http://192.168.1.100:8000/api/v1/led-state.bin?map=rev-a"

// Poll faster than the simulator changes so the serial monitor also shows 304 responses.
#define TTC_POLL_INTERVAL_MS 3000

// Hold a valid frame through short outages, then mark it stale and blank the
// TLC5947 outputs. Times are monotonic milliseconds since boot.
#define TTC_STALE_AFTER_MS 180000
#define TTC_HTTP_TIMEOUT_MS 8000

// Set to 1 while validating the wiring through the serial monitor.
#define TTC_VERBOSE_LED_LOG 1

// Set to 0 to validate only the HTTP/serial pipeline without driving GPIO pins.
#define TTC_ENABLE_SHIFT_OUTPUT 1

// Light every LED for this long at boot, before Wi-Fi, to check the wiring. 0 disables it.
#define TTC_SELF_TEST_MS 1000
