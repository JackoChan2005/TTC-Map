# Copy to .env to override any default. Every value below is optional —
# the app runs with no .env at all. See src/ttcmap/config.py for the full list.

# HOST=127.0.0.1
# PORT=8000

# Which map source to serve: auto (NTAS, falling back to schedule) | schedule | ntas
# MAP_SOURCE=auto

# How often to poll TTC's realtime feed, and how stale a snapshot may be before
# the map falls back to the schedule simulation.
# NTAS_POLL_S=30
# SNAPSHOT_MAX_AGE_S=90

# How often to check Toronto Open Data for a new GTFS feed (the feed itself
# changes every few weeks; a rebuild only happens when it actually changed).
# GTFS_CHECK_INTERVAL_S=21600

# Line 5 is opt-in after coverage validation; Line 6 is scheduled only.
# NTAS_ENABLED_LINES=["1","2","4"]
# NTAS_MIN_COVERAGE_BY_LINE={"1":0.5,"2":0.5,"4":0.5,"5":0.9}
